PORT=8080
NODE_ENV=production
JWT_SECRET=replace-with-a-strong-secret
CLIENT_URL=https://your-app-domain.com
# Public base URL used to build links inside emails (defaults to CLIENT_URL).
APP_URL=https://your-app-domain.com

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated exact browser origins allowed to call the API. NEVER use '*'.
ALLOWED_ORIGINS=https://your-app-domain.com
# Comma-separated Chrome/Firefox extension IDs allowed as origins.
EXTENSION_IDS=

# ── Transactional email (password reset, renewal reminders) ──────────────────
# EMAIL_PROVIDER=resend uses the Resend HTTP API; 'console' just logs (dev).
EMAIL_PROVIDER=console
EMAIL_API_KEY=
EMAIL_FROM=Clone2GHL <noreply@your-app-domain.com>

# ── Auth token lifetimes ─────────────────────────────────────────────────────
ACCESS_TOKEN_TTL=30m
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_RESET_TTL_MIN=30
OPENAI_API_KEY=
OPENAI_VIDEO_SCRIPT_MODEL=gpt-4.1
HEYGEN_API_KEY=
HEYGEN_BASE_URL=https://api.heygen.com
HEYGEN_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Stripe price IDs. Create these products in your Stripe Dashboard at the prices
# below (must match the in-app pricing tiles), then paste the price_xxx IDs here.
#   Starter — $27 / month
#   Pro     — $147 / month
#   Agency  — $297 / month
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_AGENCY=

# Comma-separated list of emails granted owner / admin dashboard access (Phase 4).
OWNER_EMAILS=tirandewnith@gmail.com , clone2ghl@gmail.com
ADMIN_SECRET=

# ── GoHighLevel (GHL) payment bridge ─────────────────────────────────────────
# The client sells the plans as PRODUCTS in GHL (Stripe connected via GHL).
# A GHL Workflow posts to /api/ghl/webhook on purchase; this secret authenticates
# that call (sent as header X-GHL-Token or ?token=). Use a long random string.
GHL_WEBHOOK_SECRET=
# Map each purchased GHL product (ID or exact name) to a plan key. Comma-separated
# "key=plan" pairs; key may be the product ID or its name (case-insensitive).
# Add ":lifetime" for ONE-TIME products (never expire) or ":recurring" (default,
# 31-day window re-extended by each renewal payment).
#   GHL_PRODUCT_MAP=Starter Plan=starter:lifetime, Clone2GHL Pro=pro:recurring
GHL_PRODUCT_MAP=
# Days of access granted per RECURRING payment (renewals re-extend). Default 31.
# Ignored for :lifetime products.
GHL_PERIOD_DAYS=31
# Optional: if set, the webhook also accepts a signed request (header
# X-GHL-Signature = hex HMAC-SHA256 of the raw JSON body) — forge-resistant.
GHL_WEBHOOK_HMAC=

# ── AI usage caps ────────────────────────────────────────────────────────────
# Monthly AI-call limits per plan (optimize/report/headlines). -1 = unlimited.
# Protects the shared business OpenAI key from a single user running up the bill.
AI_LIMIT_FREE=10
AI_LIMIT_STARTER=100
AI_LIMIT_PRO=1000
AI_LIMIT_AGENCY=-1
